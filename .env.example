# 实时会议 Agent 配置
# 复制本文件为 .env.local 并填入真实 key 后重启 vite dev
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
VITE_DEEPSEEK_MODEL=deepseek-chat

# DashScope Paraformer 实时 ASR（只在 Vite dev server 侧读取，不会打包进浏览器）
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference/
DASHSCOPE_ASR_MODEL=paraformer-realtime-v2
